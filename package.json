{
  "name": "cadence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop:dev": "node electron/dev-runner.cjs",
    "desktop": "npm run build && electron electron/main.cjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/patch-sdk-fonts.mjs",
    "release:archive": "python3 scripts/release_archive.py",
    "release:check": "python3 scripts/release_archive.py --check",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/karla": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@textrp/xrpl-connect": "0.6.0",
    "@vitejs/plugin-react": "^5.0.0",
    "bignumber.js": "^9.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0",
    "xrpl": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/react": "^16.3.3",
    "electron": "^41.10.7",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
